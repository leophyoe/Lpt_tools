#!/usr/bin/env python3
"""CyberSecuritySuite standalone wrapper for WAFW00F."""
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WAF_DIR = ROOT / "source" / "web" / "wafw00f"
TARGET = WAF_DIR / "wafw00f" / "bin" / "wafw00f"

if not TARGET.exists():
    sys.stderr.write(f"[-] Error: wafw00f not found at {TARGET}\n")
    sys.exit(127)

sys.path.insert(0, str(WAF_DIR))

try:
    from wafw00f.main import main
    main()
except SystemExit as exc:
    sys.exit(exc.code)
