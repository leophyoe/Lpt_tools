#!/usr/bin/env python3
"""CyberSecuritySuite standalone wrapper for SQLMap."""
import os
import sys
from pathlib import Path
import runpy

ROOT = Path(__file__).resolve().parent.parent
SQLMAP_DIR = ROOT / "source" / "web" / "sqlmap"
TARGET = SQLMAP_DIR / "sqlmap.py"

if not TARGET.exists():
    sys.stderr.write(f"[-] Error: sqlmap.py not found at {TARGET}\n")
    sys.exit(127)

sys.path.insert(0, str(SQLMAP_DIR))
sys.argv = [str(TARGET)] + sys.argv[1:]

try:
    runpy.run_path(str(TARGET), run_name="__main__")
except SystemExit as exc:
    sys.exit(exc.code)
